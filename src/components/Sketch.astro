---
// Small line drawings for cards that explain something (Kjell, 2026-10-12):
// thin grey lines, one red accent, short uppercase labels. Use them sparingly,
// only where the drawing says what the card says.
// Prop: name = pick | curve | clock | timeline | adjust
const { name } = Astro.props;
---

<div class="sketch" aria-hidden="true">
  <svg viewBox="0 0 320 160" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id={`sk-grad-${name}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e23b5b" /><stop offset="1" stop-color="#c8102e" />
      </linearGradient>
    </defs>
    <line class="sk-base" x1="24" y1="132" x2="296" y2="132" />

    {name === 'pick' && (
      <g>
        <rect class="sk-ghost" x="62" y="54" width="46" height="72" rx="8" />
        <rect class="sk-ghost" x="212" y="54" width="46" height="72" rx="8" />
        <rect class="sk-ring" x="129" y="40" width="62" height="92" rx="12" />
        <rect x="135" y="46" width="50" height="80" rx="8" fill={`url(#sk-grad-${name})`} />
        <path d="M149 86l8 8 15-17" stroke="#fff" stroke-width="3" />
        <text class="sk-label sk-red" x="160" y="30" text-anchor="middle">1 dienst</text>
      </g>
    )}

    {name === 'curve' && (
      <g>
        <path class="sk-red-line" d="M62 118 Q 96 116 124 100 T 200 72 T 262 42" />
        <circle cx="124" cy="100" r="5" fill="#c8102e" />
        <circle cx="200" cy="72" r="5" fill="#c8102e" />
        <circle class="sk-node" cx="52" cy="118" r="11" />
        <text class="sk-num" x="52" y="122" text-anchor="middle">0</text>
        <circle cx="270" cy="40" r="13" fill="#0d0d0d" />
        <text class="sk-num" x="270" y="44" text-anchor="middle" fill="#fff">1</text>
        <text class="sk-label" x="116" y="90" text-anchor="end">positionering</text>
        <text class="sk-label" x="192" y="62" text-anchor="end">strategie</text>
        <text class="sk-label" x="254" y="70" text-anchor="middle">AI</text>
      </g>
    )}

    {name === 'clock' && (
      <g>
        <circle cx="160" cy="74" r="48" stroke="#c8102e" stroke-width="2" />
        <line class="sk-tick" x1="160" y1="26" x2="160" y2="33" />
        <line class="sk-tick" x1="208" y1="74" x2="201" y2="74" />
        <line class="sk-tick" x1="160" y1="122" x2="160" y2="115" />
        <line class="sk-tick" x1="112" y1="74" x2="119" y2="74" />
        <line x1="160" y1="74" x2="160" y2="40" stroke="#0d0d0d" stroke-width="2.5" />
        <circle cx="160" cy="74" r="3.5" fill="#0d0d0d" />
        <text class="sk-label" x="160" y="98" text-anchor="middle">60 min</text>
      </g>
    )}

    {name === 'timeline' && (
      <g>
        <rect x="48" y="52" width="104" height="18" rx="5" fill={`url(#sk-grad-${name})`} />
        <text class="sk-label" x="58" y="65" fill="#fff">1 dienst</text>
        <rect class="sk-ghost" x="160" y="52" width="112" height="18" rx="5" />
        <line class="sk-line" x1="48" y1="96" x2="272" y2="96" />
        <path class="sk-node" d="M78 89l7 7-7 7-7-7z" />
        <path class="sk-node" d="M160 89l7 7-7 7-7-7z" />
        <path d="M242 89l7 7-7 7-7-7z" fill="#0d0d0d" stroke="#0d0d0d" stroke-width="1.5" />
        <text class="sk-label" x="78" y="120" text-anchor="middle">maand 1</text>
        <text class="sk-label" x="160" y="120" text-anchor="middle">maand 2</text>
        <text class="sk-label" x="242" y="120" text-anchor="middle">maand 3</text>
      </g>
    )}

    {name === 'adjust' && (
      <g>
        <line class="sk-ghost" x1="40" y1="28" x2="40" y2="132" />
        <path class="sk-ghost" d="M150 98 L 200 112" />
        <path class="sk-red-line" d="M44 120 L 110 100 L 150 98 L 196 74 L 240 62 L 276 36" />
        <circle class="sk-node" cx="150" cy="98" r="5" />
        <circle cx="276" cy="36" r="5" fill="#0d0d0d" />
        <path class="sk-line" d="M162 70 a 13 13 0 1 0 -13 -13" />
        <path class="sk-line" d="M144 52 l5 5 -6 4" />
        <text class="sk-label" x="150" y="122" text-anchor="middle">bijsturen</text>
      </g>
    )}
  </svg>
</div>

<style>
  .sketch{background:#fff;border:1px solid var(--line);border-radius:10px;margin-bottom:26px;overflow:hidden}
  .sketch svg{width:100%;height:auto}
  .sk-base{stroke:#cfccc8;stroke-width:1.5;stroke-dasharray:5 5}
  .sk-ghost{stroke:#c4c1bd;stroke-width:1.5;stroke-dasharray:5 5}
  .sk-ring{stroke:#0d0d0d;stroke-width:2}
  .sk-line{stroke:#0d0d0d;stroke-width:1.8}
  .sk-red-line{stroke:#c8102e;stroke-width:2.5}
  .sk-node{fill:#fff;stroke:#0d0d0d;stroke-width:1.8}
  .sk-tick{stroke:#c8102e;stroke-width:2}
  .sk-label{font-family:var(--font);font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;fill:#77736f;stroke:none}
  .sk-label[fill="#fff"]{fill:#fff}
  .sk-red{fill:#c8102e}
  .sk-num{font-family:var(--font);font-size:12px;font-weight:600;fill:#0d0d0d;stroke:none}
  .sk-num[fill="#fff"]{fill:#fff}
</style>
