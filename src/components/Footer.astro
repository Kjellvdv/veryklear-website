      </div>
      <div class="f-col"><h4>Diensten</h4><ul>
        <li><a href="/diensten#positionering">Positionering</a></li>
        <li><a href="/diensten#marketing-strategie">Marketing strategie</a></li>
        <li><a href="/diensten#ai-inzetten">AI inzetten</a></li>
      </ul></div>
      <div class="f-col"><h4>Very Klear</h4><ul>
        <li><a href="/fractioneel">Fractioneel</a></li>
        <li><a href="/artikels">Artikels</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul></div>
      <div class="f-col"><h4>Contact</h4><ul>
        <li><a href="mailto:kjell@veryklear.be">kjell@veryklear.be</a></li>
        <li><a href="/contact">Breydelhofstraat 52, 8900 Ieper</a></li>
      </ul></div>
      <div class="f-col"><h4>Door ons gemaakt</h4><ul>
        <li><a href="https://vcrater.com" target="_blank" rel="noopener">VC Rater</a></li>
        <li><a href="https://thecopygalaxy.com" target="_blank" rel="noopener">The Copy Galaxy</a></li>
