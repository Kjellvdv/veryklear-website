---
// White footer, no black surfaces. Copy lives in src/content/copy/site.yaml.
import { getCopy } from '../lib/copy.js';

const { footer: f } = await getCopy('site');
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap">
    <div class="f-top">
      <div>
        <svg class="logo" viewBox="0 0 960 163" role="img" aria-label="Very Klear"><use href="#vk-lockup" /></svg>
        <p>{f.about}</p>
      </div>
      <div class="f-col"><h4>{f.col_services}</h4><ul>
        <li><a href="/positionering">Positionering</a></li>
        <li><a href="/marketing-strategie">Marketing strategie</a></li>
        <li><a href="/ai">AI implementeren</a></li>
      </ul></div>
      <div class="f-col"><h4>{f.col_company}</h4><ul>
        <li><a href="/fractioneel">Fractioneel</a></li>
        <li><a href="/partners">Partners</a></li>
        <li><a href="/artikels">Artikels</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul></div>
      <div class="f-col"><h4>{f.col_contact}</h4><ul>
        <li><a href={`mailto:${f.email}`}>{f.email}</a></li>
        <li><a href="/contact">{f.address}</a></li>
      </ul></div>
      <div class="f-col"><h4>{f.col_made_by_us}</h4><ul>
        <li><a href="https://vcrater.com" target="_blank" rel="noopener">VC Rater</a></li>
        <li><a href="https://thecopygalaxy.com" target="_blank" rel="noopener">The Copy Galaxy</a></li>
      </ul></div>
    </div>
    <div class="f-bottom"><span>&copy; {year} {f.copyright}</span><span>BTW {f.vat_number}</span></div>
  </div>
</footer>
