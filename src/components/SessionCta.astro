---
// The page's single red surface. Pricing stays on /strategiesessie only.
const {
  heading = 'Weten of dit iets voor jou is?',
  body = 'Eén gesprek van een uur, en je weet waar je best aan begint. Denken we dat je ons niet nodig hebt, dan zeggen we dat ook.',
} = Astro.props;
---

<section class="section section--red">
  <div class="shell">
    <div class="prose">
      <h2>{heading}</h2>
      <p class="lead">{body}</p>
      <div class="btn-row">
        <a class="btn" href="/strategiesessie">Boek een strategiesessie &rarr;</a>
        <a href="mailto:kjell@veryklear.be">Of stuur gewoon een mail</a>
      </div>
    </div>
  </div>
</section>
