---
// Line illustration behind the strategiesessie card in the home hero
// (Kjell, 2026-10-07, after lemonade.com's hero). A ridge rises from the middle
// of the hero to the top right on an organic line, with map-like contour lines
// under it and a dashed route climbing to a flag: finding the way up.
// White strokes at low opacity so it sits on the red gradient without competing.

// Catmull-Rom through the points, as cubic Bézier segments: smooth, not straight.
const smooth = (pts) => {
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1.map((n) => n.toFixed(1)).join(',')} ${c2.map((n) => n.toFixed(1)).join(',')} ${p2.join(',')}`;
  }
  return d;
};

// The ridge, in a 1000 × 700 box anchored bottom right.
const ridge = [
  [0, 560], [90, 528], [170, 512], [250, 470], [330, 458], [410, 405], [480, 392],
  [560, 330], [640, 302], [710, 236], [780, 200], [850, 128], [920, 82], [1000, 30],
];
const ridgePath = smooth(ridge);
const area = `${ridgePath} L1000,700 L0,700 Z`;

// Contour lines: the ridge, lowered step by step, each with its own small wobble.
const contours = Array.from({ length: 9 }, (_, k) => {
  const n = k + 1;
  return smooth(
    ridge.map(([x, y], i) => [
      x - n * 14,
      y + n * 52 + Math.sin(i * 1.3 + n * 0.9) * (6 + n * 1.5),
    ])
  );
});

// A dashed route climbing to the flag on the ridge.
const route = smooth([
  [150, 720], [215, 668], [190, 618], [285, 588], [380, 566], [350, 515],
  [455, 482], [560, 460], [530, 408], [640, 372], [720, 344], [700, 290],
  [790, 250], [835, 190], [850, 136],
]);
const stops = [[285, 588], [530, 408], [790, 250]];
---

<svg class="hero-illus" viewBox="0 0 1000 700" preserveAspectRatio="xMaxYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="hero-illus-area"><path d={area} /></clipPath>
    <linearGradient id="hero-illus-fade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.35" stop-color="#fff" stop-opacity="1" />
    </linearGradient>
    <mask id="hero-illus-mask"><rect width="1000" height="700" fill="url(#hero-illus-fade)" /></mask>
  </defs>
  <g mask="url(#hero-illus-mask)">
    <path d={area} class="hi-fill" />
    <g clip-path="url(#hero-illus-area)">
      {contours.map((d) => <path d={d} class="hi-contour" />)}
    </g>
    <path d={ridgePath} class="hi-ridge" />
    <path d={route} class="hi-route" />
    {stops.map(([x, y]) => <circle cx={x} cy={y} r="6" class="hi-stop" />)}
    <line x1="850" y1="132" x2="850" y2="62" class="hi-pole" />
    <path d="M851,64 L902,78 L851,93 Z" class="hi-flag" />
  </g>
</svg>

<style>
  .hero-illus {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 64%;
    height: 92%;
    z-index: 0;
    pointer-events: none;
  }
  .hi-fill { fill: rgba(255, 255, 255, 0.1); }
  .hi-contour { fill: none; stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.5; }
  .hi-ridge { fill: none; stroke: rgba(255, 255, 255, 0.55); stroke-width: 2.5; stroke-linecap: round; }
  .hi-route { fill: none; stroke: rgba(255, 255, 255, 0.75); stroke-width: 3; stroke-dasharray: 2 11; stroke-linecap: round; }
  .hi-stop { fill: #fff; fill-opacity: 0.9; }
  .hi-pole { stroke: #fff; stroke-width: 3; stroke-linecap: round; }
  .hi-flag { fill: #fff; }
  @media (max-width: 900px) {
    .hero-illus { width: 100%; height: 55%; opacity: 0.7; }
  }
</style>
