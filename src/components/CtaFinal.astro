---
// The closing CTA on every page. The strategiesessie is free for now, but that
// is never highlighted (products.yml strategiesessie.price_status).
// Copy: pass a page's `cta` section as `copy`; missing fields fall back to site.yaml.
import { getCopy } from '../lib/copy.js';

const site = await getCopy('site');
const { copy = {}, variant = 'grad' } = Astro.props;
const heading = copy.heading ?? site.cta.heading;
const body = copy.body ?? site.cta.body;
const button = copy.button ?? site.cta.button;
---

<section class="block" style="padding-top:0">
  <div class="wrap">
    {variant === 'grad' ? (
      <div class="card card-grad cut cta-final">
        <div class="grain"></div>
        <div style="position:relative">
          <h2>{heading}</h2>
          <p class="muted">{body}</p>
        </div>
        <div style="position:relative"><a class="btn btn-white" href="/contact">{button}</a></div>
      </div>
    ) : (
      <div class="card card-paper cta-final">
        <div>
          <h2>{heading}</h2>
          <p class="muted">{body}</p>
        </div>
        <a class="btn btn-red" href="/contact">{button}</a>
      </div>
    )}
  </div>
</section>
