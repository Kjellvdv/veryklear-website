---
const { path = '' } = Astro.props;

const links = [
  { href: '/strategie', label: 'Strategie' },
  { href: '/automatisatie', label: 'Automatisatie' },
  { href: '/websites', label: 'Websites' },
  { href: '/partners', label: 'Partners' },
  { href: '/artikels', label: 'Artikels' },
  { href: '/contact', label: 'Contact' },
];
---

<header>
  <div class="wrap">
    <a class="brand" href="/" aria-label="Very Klear, naar de homepagina">
      <img src="/vk-lockup-black.svg" alt="Very Klear" width="129" height="40" />
    </a>
    <nav>
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
