---
const { path = '' } = Astro.props;

const links = [
  { href: '/strategie', label: 'Strategie' },
  { href: '/automatisatie', label: 'Automatisatie' },
  { href: '/websites', label: 'Websites' },
  { href: '/partners', label: 'Partners' },
  { href: '/artikels', label: 'Artikels' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="masthead">
  <div class="shell">
    <a class="masthead__brand" href="/" aria-label="Very Klear, naar de homepagina">
      <img src="/vk-lockup-gradient.svg" alt="Very Klear" width="161" height="50" />
    </a>
    <nav>
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
