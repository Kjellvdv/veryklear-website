---
// Copy lives in src/content/copy/home.yaml. This file is layout only.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles.js';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('home');
const booking = (await getCopy('site')).booking_url;
const recent = (await getArticles()).slice(0, 3);
---

<Base title={c.meta.title} description={c.meta.description} path="/">
  <section class="hero hero-home">
    <div class="grain"></div>
    <div class="wrap hero-grid">
      <div>
        <h1 class="h-display" set:html={c.hero.title_html} />
        <p class="lead">{c.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-white" href={booking} target="_blank" rel="noopener">{c.hero.button_primary}</a>
          <a class="btn btn-ghost-white" href="/diensten">{c.hero.button_secondary}</a>
        </div>
      </div>
      <aside class="hero-entry">
        <span class="label">{c.hero.entry.label}</span>
        <h3 class="h-card" style="margin-top:6px">{c.hero.entry.title}</h3>
        <p class="muted" style="margin-top:8px;font-size:.93rem">{c.hero.entry.body}</p>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:20px;gap:12px">
          <span class="muted" style="font-size:.88rem;font-weight:600">{c.hero.entry.meta}</span>
          <a class="link-arrow" href={booking} target="_blank" rel="noopener">{c.hero.entry.link}</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.problems.title}</h2>
        <p class="lead">{c.problems.lead}</p>
      </div>
      <div class="grid-3">
        {c.problems.items.map((p) => (
          <article class="card card-paper problem">
            <p class="q">{p.quote}</p>
            <p class="a muted">{p.body}</p>
            <span class="tag">{p.tag}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.paths.title}</h2>
      </div>
      <div class="grid-2">
        {[[c.paths.project, '/diensten'], [c.paths.fractional, '/fractioneel']].map(([p, href]) => (
          <a class="card card-paper" href={href} style="text-decoration:none">
            <span class="label">{p.label}</span>
            <h3 class="h-card" style="margin-top:6px">{p.title}</h3>
            <p class="muted">{p.body}</p>
            <div class="card-foot"><span class="link-arrow">{p.link}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head-row">
        <div class="s-head">
          <h2 class="h-section">{c.pillars.title}</h2>
          <p class="lead">{c.pillars.lead}</p>
        </div>
        <a class="link-arrow" href="/diensten">{c.pillars.link}</a>
      </div>
      <div class="flow">
        {c.pillars.items.map((p, i) => (
          <>
            {i > 0 && <span class="flow-arrow" aria-hidden="true">→</span>}
            <article class={`card pillar-card ${i === 0 ? 'card-grad cut' : 'card-paper'}`}>
              {i === 0 && <div class="grain"></div>}
              <span class="num">{p.label}</span>
              <h3 class="h-card" style="margin-top:8px">{p.title}</h3>
              <ul>{p.questions.map((q) => <li>{q}</li>)}</ul>
            </article>
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="card card-grad cut statement">
        <div class="grain"></div>
        <div style="position:relative">
          <h2>{c.statement.title}</h2>
          <p class="muted" style="margin-top:16px;max-width:48ch">{c.statement.body}</p>
        </div>
        <div class="facts" style="position:relative">
          {c.statement.facts.map((f) => <div class="fact"><b>{f.value}</b><span>{f.text}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.steps.title}</h2></div>
      <div class="steps">
        {c.steps.items.map((s) => (
          <div class="card card-paper step">
            <div class="n"></div>
            <h3 class="h-card">{s.title}</h3>
            <p class="muted">{s.body}</p>
            <p class="meta">{s.meta}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Proof section (ZYGO story + quote) stays out until there's a real quote.
      Nothing on this site is invented. */}

  {recent.length > 0 && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head-row">
          <div class="s-head"><h2 class="h-section">{c.recent.title}</h2></div>
          <a class="link-arrow" href="/artikels">{c.recent.link}</a>
        </div>
        <div class="grid-3">
          {recent.map((post, i) => <ArticleCard post={post} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <section class="block" style="padding-top:0">
    <div class="wrap faq-layout">
      <div class="s-head" style="margin-bottom:0">
        <h2 class="h-section">{c.faq.title}</h2>
        <p class="lead">{c.faq.lead}</p>
        <div style="margin-top:22px"><a class="btn btn-line" href="/contact">{c.faq.button}</a></div>
      </div>
      <Faq items={c.faq.items} />
    </div>
  </section>

  <CtaFinal copy={c.cta} />
</Base>
