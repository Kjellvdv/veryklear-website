---
import Base from '../layouts/Base.astro';
import SessionCta from '../components/SessionCta.astro';
---

<Base
  title="Contact — Very Klear"
  description="Contactgegevens van Very Klear, marketingbureau uit Ieper."
  path="/contact"
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1 class="display">Een mail is het snelst.</h1>
      <p class="lead prose">
        Zeg er kort bij waar je mee bezig bent, dan kunnen we meteen iets zinnigs
        antwoorden.
      </p>
      <div class="btn-row">
        <a class="btn" href="mailto:kjell@veryklear.be">kjell@veryklear.be</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div><span class="idx">01</span><h2>Adres</h2></div>
      <div class="prose">
        <p>
          Very Klear<br />
          Breydelhofstraat 52<br />
          8900 Ieper<br />
          BTW BE1014759659
        </p>
      </div>
    </div>
  </section>

  <SessionCta
    heading="Liever meteen een gesprek?"
    body="Eén uur waarin we overlopen waar je staat en wat de moeite is om aan te pakken."
  />
</Base>
