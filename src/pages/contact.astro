---
// Copy lives in src/content/copy/contact.yaml; contact details in site.yaml.
import Base from '../layouts/Base.astro';
import { PILLARS } from '../lib/articles.js';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('contact');
const { footer: site } = await getCopy('site');
const topics = [...PILLARS, ...c.form.topics_extra];
const [street, city] = site.address.split(', ');
---

<Base title={c.meta.title} description={c.meta.description} path="/contact">
  <section class="hero hero-page">
    <div class="grain"></div>
    <div class="wrap">
      <h1 class="h-page">{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap contact-grid">
      <div class="card card-paper">
        <h2 class="h-section" style="font-size:1.6rem">{c.form.title}</h2>
        <p class="muted" style="margin-top:8px">{c.form.intro}</p>
        <!-- No form backend yet: submitting opens the visitor's mail app with the
             message filled in, addressed to kjell@veryklear.be. -->
        <form class="form" id="contactForm" style="margin-top:28px" action={`mailto:${site.email}`} method="post" enctype="text/plain">
          <div class="row">
            <div class="field"><label for="f-name">{c.form.name_label}</label><input id="f-name" name="name" autocomplete="name" placeholder={c.form.name_placeholder} required /></div>
            <div class="field"><label for="f-company">{c.form.company_label}</label><input id="f-company" name="company" autocomplete="organization" placeholder={c.form.company_placeholder} /></div>
          </div>
          <div class="field"><label for="f-mail">{c.form.email_label}</label><input id="f-mail" name="email" type="email" autocomplete="email" placeholder={c.form.email_placeholder} required /></div>
          <div class="field">
            <span class="label-like" style="display:block;font-size:.85rem;font-weight:700;margin-bottom:7px">{c.form.topics_label}</span>
            <div class="chips" id="topicChips">
              {topics.map((t) => <button type="button" class="chip chip-dark" data-topic={t} aria-pressed="false">{t}</button>)}
            </div>
          </div>
          <div class="field">
            <label for="f-msg">{c.form.message_label}</label>
            <textarea id="f-msg" name="message" placeholder={c.form.message_placeholder}></textarea>
            <p class="hint">{c.form.message_hint}</p>
          </div>
          <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
            <button class="btn btn-red" type="submit">{c.form.submit}</button>
            <span class="form-note">{c.form.or_mail} <a href={`mailto:${site.email}`}>{site.email}</a></span>
          </div>
          <p class="sent" id="sent" role="status">{c.form.sent}</p>
        </form>
      </div>

      <div class="side-stack">
        <div class="card card-grad cut session">
          <div class="grain"></div>
          <div style="position:relative">
            <span class="label">{c.session.label}</span>
            <h3 class="h-card" style="margin-top:6px;font-size:1.4rem">{c.session.title}</h3>
            <p class="muted" style="margin-top:10px">{c.session.body}</p>
            <ul>{c.session.points.map((p) => <li>{p}</li>)}</ul>
            <div style="margin-top:22px"><a class="btn btn-white" href={`mailto:${site.email}?subject=Strategiesessie`}>{c.session.button}</a></div>
          </div>
        </div>
        <div class="card card-paper">
          <span class="label">{c.practical.label}</span>
          <div class="detail-list" style="margin-top:12px">
            <div><span>{c.practical.email_label}</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
            <div><span>{c.practical.address_label}</span><b style="text-align:right">{street}<br />{city}</b></div>
            <div><span>{c.practical.vat_label}</span><b>{site.vat_number}</b></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.after.title}</h2></div>
      <div class="steps">
        {c.after.steps.map((s) => <div class="card card-paper step"><div class="n"></div><h3 class="h-card">{s.title}</h3><p class="muted">{s.text}</p></div>)}
      </div>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll('#topicChips .chip');
  chips.forEach((c) => {
    c.addEventListener('click', () => {
      c.classList.toggle('on');
      c.setAttribute('aria-pressed', String(c.classList.contains('on')));
    });
  });

  // Build a readable mail instead of the browser's raw form encoding.
  const form = document.getElementById('contactForm') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
    const topics = [...chips].filter((c) => c.classList.contains('on')).map((c) => (c as HTMLElement).dataset.topic);
    const subject = `Bericht via veryklear: ${v('company') || v('name')}`;
    const lines = [`Naam: ${v('name')}`];
    if (v('company')) lines.push(`Bedrijf: ${v('company')}`);
    lines.push(`E-mail: ${v('email')}`);
    if (topics.length) lines.push(`Onderwerp: ${topics.join(', ')}`);
    const body = [...lines, '', v('message')].join('\n');
    window.location.href = `${form.getAttribute('action')}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    document.getElementById('sent')?.classList.add('show');
  });
</script>
