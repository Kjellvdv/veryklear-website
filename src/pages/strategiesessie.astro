---
// Booking page with the Google Calendar booking page embedded. Every "Plan een
// strategiesessie" button on the site points here. Copy lives in
// src/content/copy/strategiesessie.yaml; the booking addresses in site.yaml.
// No hero, like contact (Kjell, 2026-10-14): it opens straight on the calendar.
import Base from '../layouts/Base.astro';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('strategiesessie');
const { booking_url, booking_embed } = await getCopy('site');
---

<Base title={c.meta.title} description={c.meta.description} path="/strategiesessie">
  <section class="block" style="padding-top:72px">
    <div class="wrap booking-grid">
      <div class="card card-paper booking-card">
        <div class="booking-head">
          <h1 class="h-section" style="font-size:1.6rem">{c.intro.title}</h1>
          <p class="muted" style="margin-top:8px">{c.intro.lead}</p>
        </div>
        <div class="booking-embed">
          <p class="booking-loading" aria-hidden="true">{c.loading}</p>
          <iframe class="booking-frame" src={booking_embed} title={c.frame_title} loading="lazy"></iframe>
        </div>
        <p class="booking-open"><a class="btn btn-red" href={booking_url} target="_blank" rel="noopener">{c.open_button}</a></p>
        <noscript><p><a href={booking_url}>{c.fallback_link}</a></p></noscript>
        <p class="muted booking-fallback">{c.fallback} <a href={booking_url} target="_blank" rel="noopener">{c.fallback_link}</a></p>
      </div>
      <aside class="card card-grad cut session">
        <div class="grain"></div>
        <div style="position:relative">
          <h2 class="h-card" style="font-size:1.3rem">{c.side.title}</h2>
          <ul>{c.side.points.map((p) => <li>{p}</li>)}</ul>
          <p style="margin-top:24px;font-weight:600">{c.side.question}</p>
          <a class="link-arrow" href="/contact" style="margin-top:6px">{c.side.question_link}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

