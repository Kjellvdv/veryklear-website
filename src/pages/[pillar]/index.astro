---
// One page per dienst: /positionering, /marketing-strategie, /ai.
// Copy lives in src/content/copy/dienst-<pillar>.yaml; partner cards come from
// partners.yaml. The pillar's artikels are listed near the bottom; the
// artikels themselves live at /artikels/<pillar>/<slug>.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Faq from '../../components/Faq.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import { getArticles, PILLARS, PILLAR_SLUG, PILLAR_COPY } from '../../lib/articles.js';
import { getCopy } from '../../lib/copy.js';

export async function getStaticPaths() {
  const posts = await getArticles();
  return PILLARS.map((name) => ({
    params: { pillar: PILLAR_SLUG[name] },
    props: { name, posts: posts.filter((p) => p.data.category === name) },
  }));
}

const { name, posts } = Astro.props;
const c = await getCopy(PILLAR_COPY[name]);
const partners = await getCopy('partners');
const booking = (await getCopy('site')).booking_page;
const { dienst_page: d } = await getCopy('site');
---

<Base title={c.meta.title} description={c.meta.description} path="/diensten">
  <Hero title={c.hero.title_html} lead={c.hero.lead}>
    <a class="btn btn-white" href={booking}>{c.hero.button}</a>
  </Hero>

  <section class="block block-first">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.when.title}</h2></div>
      <div class="pillar pillar-when">
      <div class="pillar-intro">
        <div class="when">{c.when.items.map((w) => <div class="when-item">{w}</div>)}</div>
      </div>
      <div class="card card-grad cut">
        <div class="grain"></div>
        <div style="position:relative">
          <h3 class="h-card">{c.questions.title}</h3>
          <ul class="q-list">{c.questions.items.map((q) => <li>{q}</li>)}</ul>
        </div>
      </div>
      </div>
    </div>
  </section>

  {/* Sales-page arc (Kjell, 2026-10-21): problem, what it leads to, solution,
      transformation, how it works, call to action. The next three sections only
      render when their key is in the YAML. */}
  {c.consequences && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head">
          <h2 class="h-section">{c.consequences.title}</h2>
          {c.consequences.lead && <p class="lead">{c.consequences.lead}</p>}
        </div>
        <div class="grid-3">
          {c.consequences.items.map((i) => (
            <div class="card card-paper"><h3 class="h-card">{i.title}</h3><p class="muted">{i.text}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Only the AI page has stages: what's worth doing depends on where a team stands. */}
  {c.stages && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head">
          <h2 class="h-section">{c.stages.title}</h2>
          <p class="lead">{c.stages.lead}</p>
        </div>
        <div class="grid-3">
          {c.stages.items.map((s) => (
            <div class="card card-paper stage">
              <div class="n"></div>
              <h3 class="h-card">{s.name}</h3>
              <p class="muted">{s.situation}</p>
              <ul>{s.what.map((w) => <li>{w}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.approach.title}</h2>
      </div>
      <div class="steps">
        {c.approach.steps.map((s) => (
          <div class="card card-paper step">
            <div class="n"></div>
            <h3 class="h-card">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        ))}
      </div>
      <div class="card card-tint deliver-band">
        <span class="label">{c.deliver.title}</span>
        <p>{c.deliver.text}</p>
      </div>
    </div>
  </section>

  {c.split && (
    <section class="block" style="padding-top:0">
      <div class="wrap grid-3">
        <div class="card card-tint">
          <span class="label">{c.split.ai_title}</span>
          <p style="margin-top:8px">{c.split.ai}</p>
        </div>
        <div class="card card-paper">
          <span class="label">{c.split.you_title}</span>
          <p style="margin-top:8px">{c.split.you}</p>
        </div>
        <div class="card card-paper">
          <span class="label">{c.split.never_title}</span>
          <ul class="never-list">{c.split.never.map((n) => <li>{n}</li>)}</ul>
        </div>
      </div>
    </section>
  )}

  {c.transformation && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head">
          <h2 class="h-section">{c.transformation.title}</h2>
          {c.transformation.lead && <p class="lead">{c.transformation.lead}</p>}
        </div>
        <div class="before-after">
          <div class="card card-paper ba-before">
            <span class="label">{c.transformation.before_title}</span>
            <ul>{c.transformation.before.map((l) => <li>{l}</li>)}</ul>
          </div>
          <div class="card card-tint ba-after">
            <span class="label">{c.transformation.after_title}</span>
            <ul>{c.transformation.after.map((l) => <li>{l}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {c.mid_cta && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="card card-paper mid-cta">
          <div><h3 class="h-card">{c.mid_cta.title}</h3><p class="muted">{c.mid_cta.text}</p></div>
          <a class="btn btn-red" href={booking}>{c.mid_cta.button}</a>
        </div>
      </div>
    </section>
  )}

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.leads_to.title}</h2>
      </div>
      <div class={c.leads_to.items.length === 3 ? 'grid-3' : 'grid-4'}>
        {/* No links on these cards (Kjell, 2026-10-23). */}
        {c.leads_to.items.map((l) => (
          <div class="card card-paper next-card">
            <h3 class="h-card">{l.title}</h3>
            <p class="muted">{l.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head-row">
        <div class="s-head">
          <h2 class="h-section">{c.partners.title}</h2>
        </div>
        <a class="link-arrow" href="/partners">{d.all_partners}</a>
      </div>
      <div class="partners partners-lg">
        {c.partners.keys.map((k) => <PartnerCard partner={partners.items[k]} />)}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head"><h2 class="h-section">{c.articles.title}</h2></div>
        <div class="grid-3">
          {posts.map((post, i) => <ArticleCard post={post} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <section class="block" style="padding-top:0">
    <div class="wrap faq-layout">
      <div class="s-head" style="margin-bottom:0">
        <h2 class="h-section">{c.faq.title}</h2>
      </div>
      <Faq items={c.faq.items} />
    </div>
  </section>

  <CtaFinal copy={c.cta} />
</Base>
