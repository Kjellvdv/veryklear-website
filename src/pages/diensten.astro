---
// The short overview. Each pillar has its own page; copy lives in
// src/content/copy/diensten.yaml.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { PILLARS, pillarUrl } from '../lib/articles.js';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('diensten');
---

<Base title={c.meta.title} description={c.meta.description} path="/diensten">
  <section class="hero hero-page">
    <div class="grain"></div>
    <div class="wrap">
      <h1 class="h-page" set:html={c.hero.title_html} />
      <p class="lead">{c.hero.lead}</p>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap grid-3">
      {c.pillars.map((p, i) => (
        <a class={`card pillar-card overview-card ${i === 0 ? 'card-grad cut' : 'card-paper'}`} href={pillarUrl(PILLARS[i])}>
          {i === 0 && <div class="grain"></div>}
          <span class="num">{p.label}</span>
          <h2 class="h-card" style="margin-top:8px;font-size:1.5rem">{p.title}</h2>
          <p class={i === 0 ? '' : 'muted'} style="margin-top:10px">{p.text}</p>
          <ul>{p.points.map((q) => <li>{q}</li>)}</ul>
          <div class="card-foot"><span class="link-arrow">{p.link}</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap grid-2">
      <a class="card card-paper overview-card" href="/partners">
        <h2 class="h-card" style="font-size:1.35rem">{c.partners.title}</h2>
        <p class="muted" style="margin-top:10px;flex:1">{c.partners.lead}</p>
        <div class="card-foot"><span class="link-arrow">{c.partners.link}</span></div>
      </a>
      <a class="card card-tint overview-card" href="/fractioneel">
        <h2 class="h-card" style="font-size:1.35rem">{c.fractional.title}</h2>
        <p style="margin-top:10px;flex:1">{c.fractional.text}</p>
        <div class="card-foot"><span class="link-arrow">{c.fractional.link}</span></div>
      </a>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap faq-layout">
      <div class="s-head" style="margin-bottom:0">
        <h2 class="h-section">{c.faq.title}</h2>
        <p class="lead">{c.faq.lead}</p>
      </div>
      <Faq items={c.faq.items} />
    </div>
  </section>

  <CtaFinal copy={c.cta} />
</Base>
