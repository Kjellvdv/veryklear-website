---
// Copy lives in src/content/copy/fractioneel.yaml. This file is layout only.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { PILLARS } from '../lib/articles.js';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('fractioneel');
const booking = (await getCopy('site')).booking_page;
const last = c.timeline.steps.length - 1;
---

<Base title={c.meta.title} description={c.meta.description} path="/fractioneel">
  <section class="hero hero-page">
    <div class="grain"></div>
    <div class="wrap">
      <h1 class="h-page" set:html={c.hero.title_html} />
      <p class="lead">{c.hero.lead}</p>
      <div class="hero-ctas">
        <a class="btn btn-white" href={booking}>{c.hero.button_primary}</a>
        <a class="btn btn-ghost-white" href="#vergelijking">{c.hero.button_secondary}</a>
      </div>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.timeline.title}</h2>
      </div>
      <div class="card card-paper" style="padding:44px 36px">
        <div class="timeline">
          {c.timeline.steps.map((s, i) => (
            <div class={i === last ? 'tl end' : 'tl'}>
              <div class="dot">{i === 0 ? '0' : i === last ? '1' : ''}</div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.included.title}</h2></div>
      <div class="card card-grad cut" style="padding:40px">
        <div class="grain"></div>
        <div style="position:relative;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center">
          <div>
            <span class="label">{c.included.base_label}</span>
            <h3 class="h-card" style="margin-top:6px;font-size:1.5rem">{c.included.base_title}</h3>
          </div>
          <div class="leads-to" style="margin-top:0">{PILLARS.map((p) => <span>{p}</span>)}</div>
        </div>
      </div>
      <div class="grid-4" style="margin-top:20px">
        {c.included.extras.map((e) => (
          <div class="card card-paper"><span class="label">{c.included.extra_label}</span><h3 class="h-card" style="margin-top:6px">{e.title}</h3><p class="muted">{e.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0;scroll-margin-top:24px" id="vergelijking">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.compare.title}</h2>
      </div>
      <div class="compare">
        {c.compare.columns.map((col) => (
          <div class="card card-paper">
            <h3 class="h-card">{col.title}</h3>
            <dl>
              {col.rows.map((r) => <><dt>{r.label}</dt><dd>{r.value}</dd></>)}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="grid-2 fit">
        <div class="card card-paper yes">
          <h3 class="h-card">{c.fit.yes_title}</h3>
          <ul>{c.fit.yes.map((l) => <li>{l}</li>)}</ul>
        </div>
        <div class="card card-tint no">
          <h3 class="h-card">{c.fit.no_title}</h3>
          <ul>{c.fit.no.map((l) => <li>{l}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="card card-paper">
        <p style="font-weight:600">{c.note}</p>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="card card-paper side-band">
        <div>
          <span class="label">{c.vcrater.label}</span>
          <h3 style="margin-top:6px">{c.vcrater.title}</h3>
          <p class="muted">{c.vcrater.body}</p>
        </div>
        <a class="btn btn-line" href="https://vcrater.com" target="_blank" rel="noopener">{c.vcrater.button}</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap faq-layout">
      <div class="s-head" style="margin-bottom:0">
        <h2 class="h-section">{c.faq.title}</h2>
      </div>
      <Faq items={c.faq.items} />
    </div>
  </section>

  <CtaFinal copy={c.cta} />
</Base>
