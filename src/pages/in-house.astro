---
// Copy lives in src/content/copy/in-house.yaml. This file is layout only.
// Was /fractioneel until 2026-10-21 (Kjell: "fractioneel is not the right word").
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { PILLARS } from '../lib/articles.js';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('in-house');
const booking = (await getCopy('site')).booking_page;
const last = c.timeline.steps.length - 1;
---

<Base title={c.meta.title} description={c.meta.description} path="/in-house">
  <Hero title={c.hero.title_html} lead={c.hero.lead}>
    <a class="btn btn-white" href={booking}>{c.hero.button_primary}</a>
    <a class="btn btn-ghost-white" href="#vergelijking">{c.hero.button_secondary}</a>
  </Hero>

  {/* Sales-page arc (Kjell, 2026-10-21): problem, what it leads to, the 0-to-1
      path, fit, what's included, transformation, call to action. `when`,
      `consequences`, `transformation` and `mid_cta` only render when present. */}
  {c.when && (
    <section class="block block-first">
      <div class="wrap">
        <div class="s-head"><h2 class="h-section">{c.when.title}</h2></div>
        <div class="grid-2 when">{c.when.items.map((w) => <div class="when-item">{w}</div>)}</div>
      </div>
    </section>
  )}

  {c.consequences && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head">
          <h2 class="h-section">{c.consequences.title}</h2>
          {c.consequences.lead && <p class="lead">{c.consequences.lead}</p>}
        </div>
        <div class="grid-3">
          {c.consequences.items.map((i) => (
            <div class="card card-paper"><h3 class="h-card">{i.title}</h3><p class="muted">{i.text}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class={c.when ? 'block' : 'block block-first'} style={c.when ? 'padding-top:0' : undefined}>
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.timeline.title}</h2>
      </div>
      <div class="card card-paper" style="padding:44px 36px">
        <div class="timeline">
          {c.timeline.steps.map((s, i) => (
            <div class={i === last ? 'tl end' : 'tl'}>
              <div class="dot">{i === 0 ? '0' : i === last ? '1' : ''}</div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Fit comes before what's included (Kjell, 2026-10-21). */}
  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="grid-2 fit">
        <div class="card card-paper yes">
          <h3 class="h-card">{c.fit.yes_title}</h3>
          <ul>{c.fit.yes.map((l) => <li>{l}</li>)}</ul>
        </div>
        <div class="card card-tint no">
          <h3 class="h-card">{c.fit.no_title}</h3>
          <ul>{c.fit.no.map((l) => <li>{l}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.included.title}</h2></div>
      <div class="card card-grad cut" style="padding:40px">
        <div class="grain"></div>
        <div style="position:relative;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:center">
          <div>
            <span class="label">{c.included.base_label}</span>
            <h3 class="h-card" style="margin-top:6px;font-size:1.5rem">{c.included.base_title}</h3>
          </div>
          <div class="leads-to" style="margin-top:0">{PILLARS.map((p) => <span>{p}</span>)}</div>
        </div>
      </div>
      <div class="grid-3" style="margin-top:20px">
        {c.included.extras.map((e) => (
          <div class="card card-paper"><span class="label">{c.included.extra_label}</span><h3 class="h-card" style="margin-top:6px">{e.title}</h3><p class="muted">{e.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  {c.transformation && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head">
          <h2 class="h-section">{c.transformation.title}</h2>
          {c.transformation.lead && <p class="lead">{c.transformation.lead}</p>}
        </div>
        <div class="before-after">
          <div class="card card-paper ba-before">
            <span class="label">{c.transformation.before_title}</span>
            <ul>{c.transformation.before.map((l) => <li>{l}</li>)}</ul>
          </div>
          <div class="card card-tint ba-after">
            <span class="label">{c.transformation.after_title}</span>
            <ul>{c.transformation.after.map((l) => <li>{l}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {c.mid_cta && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="card card-paper mid-cta">
          <div><h3 class="h-card">{c.mid_cta.title}</h3><p class="muted">{c.mid_cta.text}</p></div>
          <a class="btn btn-red" href={booking}>{c.mid_cta.button}</a>
        </div>
      </div>
    </section>
  )}

  <section class="block" style="padding-top:0;scroll-margin-top:24px" id="vergelijking">
    <div class="wrap">
      <div class="s-head">
        <h2 class="h-section">{c.compare.title}</h2>
      </div>
      <div class="compare">
        {c.compare.columns.map((col) => (
          <div class="card card-paper">
            <h3 class="h-card">{col.title}</h3>
            <dl>
              {col.rows.map((r) => <><dt>{r.label}</dt><dd>{r.value}</dd></>)}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="card card-paper side-band">
        <div>
          <span class="label">{c.vcrater.label}</span>
          <h3 style="margin-top:6px">{c.vcrater.title}</h3>
          <p class="muted">{c.vcrater.body}</p>
        </div>
        <a class="btn btn-line" href="https://vcrater.com" target="_blank" rel="noopener">{c.vcrater.button}</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap faq-layout">
      <div class="s-head" style="margin-bottom:0">
        <h2 class="h-section">{c.faq.title}</h2>
      </div>
      <Faq items={c.faq.items} />
    </div>
  </section>

  <CtaFinal copy={c.cta} />
</Base>
