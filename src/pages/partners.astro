---
// Copy lives in src/content/copy/partners.yaml. This file is layout only.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import PartnerCard from '../components/PartnerCard.astro';
import { getCopy } from '../lib/copy.js';

const c = await getCopy('partners');
---

<Base title={c.meta.title} description={c.meta.description} path="/diensten">
  <Hero title={c.hero.title_html} lead={c.hero.lead} />

  <section class="block block-first">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.how.title}</h2></div>
      <div class="steps">
        {c.how.items.map((s) => (
          <div class="card card-paper step">
            <div class="n"></div>
            <h3 class="h-card">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="s-head"><h2 class="h-section">{c.list_title}</h2></div>
      <div class="partners partners-lg">
        {Object.values(c.items).map((p) => <PartnerCard partner={p} />)}
      </div>
    </div>
  </section>

  <CtaFinal copy={c.cta} />
</Base>
