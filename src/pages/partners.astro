---
import Base from '../layouts/Base.astro';
import SessionCta from '../components/SessionCta.astro';

const partners = [
  { title: 'Sociale media', body: 'Posts, reels en video voor Instagram en Facebook. Zegt de strategie dat je daar moet zijn, dan wordt het gemaakt door mensen die niets anders doen.' },
  { title: 'LinkedIn', body: 'Samen met Willow, waar we al jaren mee werken. Vooral relevant als je klanten andere bedrijven zijn.' },
  { title: 'Ontwerp', body: 'Voor een logo, een huisstijl of een site die er echt moet uitspringen, werken we samen met ontwerpers die dat elke dag doen.' },
  { title: 'Bouw en platformen', body: 'Een webshop met veel schakels, een app, of iets dat verder gaat dan wat wij zelf bouwen. Dan halen we er iemand bij die dat dagelijks doet.' },
];
---

<Base
  title="Partners — Very Klear"
  description="Very Klear blijft klein en werkt samen met vaste partners voor sociale media, LinkedIn, ontwerp en zwaardere bouwprojecten."
  path="/partners"
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Partners</p>
      <h1 class="display">Met wie we werken.</h1>
      <p class="lead prose">
        Very Klear blijft bewust klein. Wat er buiten valt, doen we niet half: daar
        halen we iemand bij die er elke dag mee bezig is.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div><span class="idx">01</span><h2>Waarvoor</h2></div>
      <div>
        <ul class="steps" style="gap:2rem">
          {partners.map((p) => (
            <li><h3>{p.title}</h3><p>{p.body}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell split">
      <div><span class="idx">02</span><h2>Je hebt maar één aanspreekpunt</h2></div>
      <div class="prose">
        <p>
          Je moet niet zelf drie partijen aan het werk houden. Wij blijven het
          aanspreekpunt, ook wanneer een stuk van het werk bij iemand anders ligt.
        </p>
        <p class="muted">
          En als een partner beter geplaatst is om het rechtstreeks met jou te doen,
          zeggen we dat ook gewoon.
        </p>
      </div>
    </div>
  </section>

  <SessionCta />
</Base>
