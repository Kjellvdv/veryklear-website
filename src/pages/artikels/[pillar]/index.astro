---
// Artikels per pillar: /artikels/positionering, /artikels/marketing-strategie,
// /artikels/ai. The dienst page itself lives at /<pillar>.
// Copy lives in src/content/copy/artikels.yaml (pillar_page).
import Base from '../../../layouts/Base.astro';
import CtaFinal from '../../../components/CtaFinal.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getArticles, PILLARS, PILLAR_SLUG, pillarUrl } from '../../../lib/articles.js';
import { getCopy, fillPillar } from '../../../lib/copy.js';

export async function getStaticPaths() {
  const posts = await getArticles();
  return PILLARS.map((name) => ({
    params: { pillar: PILLAR_SLUG[name] },
    props: { name, posts: posts.filter((p) => p.data.category === name) },
  }));
}

const { name, posts } = Astro.props;
const a = await getCopy('artikels');
const c = a.pillar_page;
---

<Base title={fillPillar(c.meta_title, name)} description={fillPillar(c.meta_description, name)} path="/artikels">
  <section class="hero hero-page">
    <div class="grain"></div>
    <div class="wrap">
      <a class="crumb" href="/artikels">{c.crumb}</a>
      <h1 class="h-page">{fillPillar(c.title, name)}</h1>
      <p class="lead">{fillPillar(c.lead_before_link, name)} <a href={pillarUrl(name)} style="color:inherit;text-decoration:underline">{fillPillar(c.lead_link, name)}</a>.</p>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap">
      {posts.length === 0 ? (
        <div class="card card-paper empty">
          <h3 class="h-card">{a.empty_category_title}</h3>
          <p class="muted" style="margin-top:8px">{a.empty_category_body}</p>
        </div>
      ) : (
        <div class="grid-3">
          {posts.map((post, i) => <ArticleCard post={post} index={i} />)}
        </div>
      )}
    </div>
  </section>

  <CtaFinal variant="paper" copy={a.cta} />
</Base>
