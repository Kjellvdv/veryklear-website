---
import Base from '../../../layouts/Base.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getArticles, readingMinutes, formatDate, PILLAR_SLUG, pillarUrl, pillarArticlesUrl } from '../../../lib/articles.js';
import { getCopy, fillPillar } from '../../../lib/copy.js';

export async function getStaticPaths() {
  const posts = await getArticles();
  return posts.map((post) => ({
    params: { pillar: PILLAR_SLUG[post.data.category], slug: post.slug },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await post.render();
const toc = headings.filter((h) => h.depth === 2);
// Copy around the artikel lives in src/content/copy/artikels.yaml (article).
const c = (await getCopy('artikels')).article;

// Related: same pillar first, then the most recent of the rest.
const others = posts.filter((p) => p.slug !== post.slug);
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);
---

<Base title={`${post.data.title} · Very Klear`} description={post.data.description} path="/artikels">
  <section class="hero hero-page">
    <div class="grain"></div>
    <div class="wrap">
      <div class="article-hero">
      <a class="crumb" href="/artikels">{c.crumb}</a>
      <a class="label" href={pillarArticlesUrl(post.data.category)} style="color:#fff;display:block">{post.data.category}</a>
      <h1 class="h-page" style="margin-top:8px">{post.data.title}</h1>
      <div class="article-meta">
        <span>{c.author}</span><span>·</span>
        <span>{formatDate(post.data.published_at, 'long')}</span><span>·</span>
        <span>{readingMinutes(post.body)} {c.reading_time}</span>
      </div>
      </div>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap article-layout">
      <article class="article-body article-main">
        {post.data.image && (
          <figure class="article-figure"><img src={post.data.image} alt={post.data.image_alt} /></figure>
        )}
        <Content />
        <div class="card card-grad cut inline-cta">
          <div class="grain"></div>
          <div style="position:relative">
            <h3 class="h-card">{c.cta_title}</h3>
            <p class="muted" style="margin-top:8px">{c.cta_body}</p>
            <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap">
              <a class="btn btn-white" href="/contact">{c.cta_button}</a>
              <a class="btn btn-ghost-white" href={pillarUrl(post.data.category)}>{fillPillar(c.cta_more, post.data.category)}</a>
            </div>
          </div>
        </div>
      </article>
      <aside class="toc">
        {toc.length > 0 && (
          <div class="card card-paper" style="padding:26px">
            <span class="label">{c.toc_label}</span>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </div>
        )}
        <div class="card card-paper" style={`padding:26px${toc.length > 0 ? ';margin-top:16px' : ''}`}>
          <span class="label">{c.author_label}</span>
          <p style="margin-top:8px;font-weight:700">{c.author}</p>
          <p class="muted" style="font-size:.9rem;margin-top:4px">{c.author_bio}</p>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head"><h2 class="h-section">{c.related_title}</h2></div>
        <div class="grid-3">
          {related.map((p, i) => <ArticleCard post={p} index={i} />)}
        </div>
      </div>
    </section>
  )}
</Base>
