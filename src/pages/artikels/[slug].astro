---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, readingMinutes, formatDate, PILLAR_ANCHOR } from '../../lib/articles.js';

export async function getStaticPaths() {
  const posts = await getArticles();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await post.render();
const toc = headings.filter((h) => h.depth === 2);

// Related: same pillar first, then the most recent of the rest.
const others = posts.filter((p) => p.slug !== post.slug);
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);
---

<Base title={`${post.data.title} — Very Klear`} description={post.data.description} path="/artikels">
  <section class="hero hero-page">
    <div class="grain"></div>
    <div class="wrap narrow">
      <a class="crumb" href="/artikels">← Alle artikels</a>
      <span class="label" style="color:#fff;display:block">{post.data.category}</span>
      <h1 class="h-page" style="margin-top:8px">{post.data.title}</h1>
      <div class="article-meta">
        <span>Kjell Vandevyvere</span><span>·</span>
        <span>{formatDate(post.data.published_at, 'long')}</span><span>·</span>
        <span>{readingMinutes(post.body)} min lezen</span>
      </div>
    </div>
  </section>

  <section class="block block-first">
    <div class="wrap article-layout">
      <article class="article-body">
        <Content />
        <div class="card card-grad cut inline-cta">
          <div class="grain"></div>
          <div style="position:relative">
            <h3 class="h-card">Benieuwd wat dit voor jouw zaak betekent?</h3>
            <p class="muted" style="margin-top:8px">Daar is de strategiesessie voor. Een uur, over jouw situatie.</p>
            <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap">
              <a class="btn btn-white" href="/contact">Plan een strategiesessie</a>
              <a class="btn btn-ghost-white" href={`/diensten#${PILLAR_ANCHOR[post.data.category]}`}>Meer over {post.data.category.toLowerCase()}</a>
            </div>
          </div>
        </div>
      </article>
      <aside class="toc">
        {toc.length > 0 && (
          <div class="card card-paper" style="padding:26px">
            <span class="label">In dit artikel</span>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </div>
        )}
        <div class="card card-paper" style={`padding:26px${toc.length > 0 ? ';margin-top:16px' : ''}`}>
          <span class="label">Geschreven door</span>
          <p style="margin-top:8px;font-weight:700">Kjell Vandevyvere</p>
          <p class="muted" style="font-size:.9rem;margin-top:4px">Zeven jaar B2B tech marketing. Schrijft over wat werkt, en wat niet.</p>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="s-head"><h2 class="h-section">Lees ook</h2></div>
        <div class="grid-3">
          {related.map((p, i) => <ArticleCard post={p} index={i} />)}
        </div>
      </div>
    </section>
  )}
</Base>
