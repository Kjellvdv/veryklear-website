---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, PILLARS, articleUrl } from '../../lib/articles.js';
import { getCopy } from '../../lib/copy.js';

// Copy lives in src/content/copy/artikels.yaml.
const a = await getCopy('artikels');
const c = a.overview;

const posts = await getArticles();
const [featured, ...rest] = posts;
---

<Base title={c.meta.title} description={c.meta.description} path="/artikels">
  <Hero title={c.title} lead={c.lead}>
    {posts.length > 1 && (
      <div class="hero-chips" id="filterChips">
        <button class="chip on" type="button" data-filter="all">{c.filter_all}</button>
        {PILLARS.map((p) => <button class="chip" type="button" data-filter={p}>{p}</button>)}
      </div>
    )}
  </Hero>

  <section class="block block-first">
    <div class="wrap">
      {posts.length === 0 ? (
        <div class="card card-paper empty">
          <h3 class="h-card">{c.empty_title}</h3>
          <p class="muted" style="margin-top:8px">{c.empty_body}</p>
        </div>
      ) : (
        <>
          <a class="card card-grad cut art-featured" href={articleUrl(featured)} data-cat={featured.data.category}>
            <div class="grain"></div>
            <div class="feat-body" style="position:relative">
              <span class="label">{c.featured_label} · {featured.data.category}</span>
              <h2 style="font-size:clamp(1.5rem,2.6vw,2rem);font-weight:800;line-height:1.2">{featured.data.title}</h2>
              <p class="muted">{featured.data.description}</p>
              <span class="link-arrow" style="margin-top:8px">{c.featured_link}</span>
            </div>
            {featured.data.image
              ? <div class="feat-art feat-img"><img src={featured.data.image} alt={featured.data.image_alt} /></div>
              : <div class="feat-art"></div>}
          </a>

          {rest.length > 0 && (
            <>
              <div class="s-head-row" style="margin-top:56px">
                <div class="s-head"><h2 class="h-section">{c.all_title}</h2></div>
                <span class="muted" id="artCount" style="font-size:.9rem" data-one={c.count_one} data-many={c.count_many}>{rest.length} {rest.length === 1 ? c.count_one : c.count_many}</span>
              </div>
              <div class="grid-3" id="artGrid">
                {rest.map((post, i) => <ArticleCard post={post} index={i} />)}
              </div>
              <div class="card card-paper empty" id="artEmpty" hidden>
                <h3 class="h-card">{a.empty_category_title}</h3>
                <p class="muted" style="margin-top:8px">{a.empty_category_body}</p>
              </div>
            </>
          )}
        </>
      )}
    </div>
  </section>

  <CtaFinal variant="paper" copy={a.cta} />
</Base>

<script>
  const chips = document.querySelectorAll('#filterChips .chip');
  const featured = document.querySelector('.art-featured');
  const cards = document.querySelectorAll('#artGrid .art');
  const empty = document.getElementById('artEmpty');
  const count = document.getElementById('artCount');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.classList.toggle('on', c === chip));
      const show = (el) => f === 'all' || el.dataset.cat === f;
      if (featured) featured.hidden = !show(featured);
      let n = 0;
      cards.forEach((c) => { c.hidden = !show(c); if (!c.hidden) n++; });
      if (empty) empty.hidden = n > 0 || (featured && !featured.hidden);
      if (count) count.textContent = n + ' ' + (n === 1 ? count.dataset.one : count.dataset.many);
    });
  });
</script>
