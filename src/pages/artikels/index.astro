---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SessionCta from '../../components/SessionCta.astro';

const posts = (await getCollection('artikels', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published_at.getTime() - a.data.published_at.getTime()
);
---

<Base
  title="Artikels — Very Klear"
  description="Stukken over marketingstrategie, automatisatie en websites."
  path="/artikels"
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Artikels</p>
      <h1 class="display">Hoe we ernaar kijken.</h1>
      <p class="lead prose">Stukken over strategie, automatisatie en websites.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {posts.length === 0 ? (
        <p class="muted prose">Nog niets gepubliceerd. Binnenkort meer.</p>
      ) : (
        <ul class="steps">
          {posts.map((post) => (
            <li>
              <span class="idx">{post.data.category}</span>
              <h3><a href={`/artikels/${post.slug}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <SessionCta />
</Base>
