---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LogoSymbol from '../components/LogoSymbol.astro';
import '../styles/global.css';
import { ogPath } from '../og/pages.js';
import { getCopy } from '../lib/copy.js';

const { title, description, path = '' } = Astro.props;

// PREVIEW MODE. Off since 2026-10-06: the site is live (www.veryklear.com since 2026-10-14).
// While true every page ships noindex and no canonical. See DEPLOY.md.
const PREVIEW = false;

// Structured data for search engines (2026-10-21): who Very Klear is and where.
// A JSON data block, not a script that runs, so the CSP and the no-measuring rule
// are untouched. Contact details come from site.yaml, like the footer.
const { footer: f } = await getCopy('site');
const [street, city] = f.address.split(', ');
const [postalCode, ...town] = (city || '').split(' ');
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Very Klear',
  alternateName: 'Very Klear Marketing Agency',
  url: Astro.site.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  email: f.email,
  ...(f.phone ? { telephone: f.phone } : {}),
  vatID: f.vat_number,
  address: { '@type': 'PostalAddress', streetAddress: street, postalCode, addressLocality: town.join(' '), addressCountry: 'BE' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Vlaanderen' },
  founder: { '@type': 'Person', name: 'Kjell Vandevyvere' },
  knowsAbout: ['Positionering', 'Marketingstrategie', 'AI implementeren in marketing', 'Freelance head of marketing'],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Very Klear Marketing Agency" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL(ogPath(Astro.url.pathname), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Inter-100-900.woff2" as="font" type="font/woff2" crossorigin />
    {PREVIEW
      ? <meta name="robots" content="noindex, nofollow" />
      : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <LogoSymbol />
    <Nav path={path} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
