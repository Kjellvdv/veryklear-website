---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LogoSymbol from '../components/LogoSymbol.astro';
import '../styles/global.css';
import { ogPath } from '../og/pages.js';

const { title, description, path = '' } = Astro.props;

// PREVIEW MODE. Off since 2026-10-06: veryklear.com is the live home.
// While true every page ships noindex and no canonical. See DEPLOY.md.
const PREVIEW = false;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Very Klear" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL(ogPath(Astro.url.pathname === '/404.html' ? '/404' : Astro.url.pathname), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Inter-100-900.woff2" as="font" type="font/woff2" crossorigin />
    {PREVIEW
      ? <meta name="robots" content="noindex, nofollow" />
      : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
  </head>
  <body>
    <LogoSymbol />
    <Nav path={path} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
