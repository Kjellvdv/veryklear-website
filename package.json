{
  "name": "veryklear-website",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "npm run build && tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "check": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write server tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "~3.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^4.16.0",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "satori": "^0.35.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
