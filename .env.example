# Local port for the server (npm run serve / npm start). Railway injects PORT itself.
PORT=3011

# Folder for the SQLite file. Locally ./data (gitignored). On Railway: /data (the volume).
DATA_DIR=data

# Where the Astro build lives. Leave as is.
DIST_DIR=dist

# Password for the numbers page (HTTP Basic, any username). At least 12 characters.
REPORT_PASSWORD=change-me-to-something-long

# Path of the numbers page. Default /numeros; the JSON twin is /numeros.json.
# REPORT_PATH=/numeros

# Raw rows older than this many days are deleted. The privacy page says 14 months.
RETENTION_DAYS=400

# Set on Railway once www.veryklear.com is verified: every other Host header 301s there.
# CANONICAL_HOST=www.veryklear.com
